          "section/div:0/div:1/div:0/a:0/div:0/div:0/h3:1": "AIMAMA",
          "section/div:0/div:1/div:0/a:0/div:0/div:0/div:0/span:2": "AI Manager",
          "div/section:0/div:0/div:1/div:1/a:0": "02\n                                \n                                Cloud Systems\n                            \n                            THEME_3_Builder\n                            Next-generation cloud infrastructure visualization for real-time edge computing networks.",
          "section/div:0/div:1/div:1/a:0/div:0/div:1/h3:1": "THEME_3 Builder"
        },
        "text": "AIMANA AI is an all-in-one creative AI platform for generating, managing, and transforming digital content—combining asset management with image, audio, transcription, and chat capabilities."
      },
      "children": {},
      "canvas": null,
      "renderedContent": "\n<section class=\"pt-20 md:pt-28 pb-0\">\n    <div class=\"max-w-[1440px] mx-auto px-8 md:px-20\">\n        <div class=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-32 gap-8\">\n            <div class=\"reveal\">\n                <span class=\"text-[10px] font-bold tracking-widest-xl uppercase text-gray-400 mb-4 block\">Portfolio</span>\n                <h2 class=\"font-heading text-5xl md:text-7xl font-bold tracking-ultra-tight uppercase\">Selected <br> Works</h2>\n            </div>\n            <a href=\"project.html\" class=\"reveal font-heading font-bold text-[10px] tracking-widest-xl uppercase border-b border-black/20 dark:border-white/20 pb-2 hover:opacity-50 transition-opacity\">View All Archive</a>\n        </div>\n        \n        <div class=\"space-y-48\">\n            <!-- Project 01 -->\n            <div class=\"project-card reveal group\">\n                <a href=\"projectDetails.html\" class=\"block no-underline text-inherit\">\n                    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-16 items-center\">\n                        <div class=\"lg:col-span-5 space-y-8 order-2 lg:order-1\">\n                            <div class=\"flex items-center gap-4 text-gray-400 text-[10px] font-bold tracking-widest uppercase\">\n                                <span>01</span>\n                                <div class=\"w-8 h-[1px] bg-gray-200 dark:bg-gray-800\"></div>\n                                <span>AI Manager</span>\n                            </div>\n                            <h3 class=\"font-heading text-6xl md:text-8xl font-bold tracking-ultra-tight leading-none uppercase group-hover:italic transition-all duration-500\">AIMAMA</h3>\n                            <p class=\"text-gray-500 dark:text-gray-400 text-lg md:text-xl leading-relaxed max-w-md\">AIMANA AI is an all-in-one creative AI platform for generating, managing, and transforming digital content—combining asset management with image, audio, transcription, and chat capabilities.</p>\n                            <div class=\"project-arrow w-20 h-20 rounded-full border border-black/10 dark:border-white/10 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:rotate-45 group-hover:bg-black group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black\">\n                                <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path></svg>\n                            </div>\n                        </div>\n                        <div class=\"lg:col-span-7 order-1 lg:order-2\">\n                            <div class=\"aspect-[16/10] rounded-[3rem] overflow-hidden shadow-2xl bg-gray-100 dark:bg-zinc-900 relative\">\n                                <img src=\"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&amp;fit=crop&amp;q=80&amp;w=1200\" alt=\"Animama Project\" class=\"w-full h-full object-cover transition-transform duration-[1.5s] ease-in-out group-hover:scale-105\">\n                                <div class=\"absolute inset-0 bg-black/10 group-hover:bg-black/0 transition-colors duration-1000\"></div>\n                            </div>\n                        </div>\n                    </div>\n                </a>\n            </div>\n\n            <!-- Project 02 Teaser -->\n            <div class=\"project-card reveal group\">\n                 <a href=\"projectDetails.html\" class=\"block no-underline text-inherit\">\n                    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-16 items-center\">\n                        <div class=\"lg:col-span-7\">\n                            <div class=\"aspect-[16/10] rounded-[3rem] overflow-hidden shadow-2xl bg-gray-100 dark:bg-zinc-900 relative\">\n                                <img src=\"https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&amp;fit=crop&amp;q=80&amp;w=1200\" alt=\"Voyager Project\" class=\"w-full h-full object-cover transition-transform duration-[1.5s] ease-in-out group-hover:scale-105\">\n                            </div>\n                        </div>\n                        <div class=\"lg:col-span-5 space-y-8\">\n                            <div class=\"flex items-center gap-4 text-gray-400 text-[10px] font-bold tracking-widest uppercase\">\n                                <span>02</span>\n                                <div class=\"w-8 h-[1px] bg-gray-200 dark:bg-gray-800\"></div>\n                                <span>Cloud Systems</span>\n                            </div>\n                            <h3 class=\"font-heading text-6xl md:text-8xl font-bold tracking-ultra-tight leading-none uppercase group-hover:italic transition-all duration-500\">THEME_3 Builder</h3>\n                            <p class=\"text-gray-500 dark:text-gray-400 text-lg md:text-xl leading-relaxed max-w-md\">Next-generation cloud infrastructure visualization for real-time edge computing networks.</p>\n                            <div class=\"project-arrow w-20 h-20 rounded-full border border-black/10 dark:border-white/10 flex items-center justify-center transition-all duration-700 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:rotate-45 group-hover:bg-black group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-black\">\n                                <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path></svg>\n                            </div>\n                        </div>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>\n"
