      "renderedContent": "\n<section class=\"py-20 border-b border-black/5 dark:border-white/5 bg-white dark:bg-[#0a0a0a]\">\n    <div class=\"max-w-[1440px] mx-auto px-8 md:px-20\">\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 reveal text-center items-center\">\n            <!-- Role -->\n            <div class=\"space-y-2\">\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest-xl\">Role</p>\n                <p class=\"font-heading font-bold text-lg uppercase\">Lead Product Designer</p>\n            </div>\n            \n            <!-- Resources / Deliverables -->\n            <div class=\"space-y-4\">\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest-xl\">Resources</p>\n                <div class=\"flex flex-wrap justify-center gap-3\">\n                    <a href=\"#\" class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-black/10 dark:border-white/10 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all text-[10px] font-bold tracking-widest uppercase\">\n                        Code\n                        <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"></path></svg>\n                    </a>\n                    <a href=\"#\" class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-black/10 dark:border-white/10 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all text-[10px] font-bold tracking-widest uppercase\">\n                        Video\n                        <svg class=\"w-3 h-3\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"></path></svg>\n                    </a>\n                    <a href=\"#\" class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-black/10 dark:border-white/10 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-all text-[10px] font-bold tracking-widest uppercase\">\n                        Tutorial\n                        <svg class=\"w-3 h-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253\"></path></svg>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n"
