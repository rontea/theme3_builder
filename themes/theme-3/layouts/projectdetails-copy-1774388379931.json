    {
      "id": "instance-1774388344414-ax8crztu5",
      "order": 3,
      "type": "partial",
      "partial": "project-details/detail_narrative.html",
      "componentPath": "project-details/detail_narrative.html",
      "name": "detail_narrative",
      "props": {},
      "children": {},
      "canvas": null,
      "renderedContent": "\n<section class=\"py-24 md:py-32\">\n    <div class=\"max-w-[1440px] mx-auto px-8 md:px-20\">\n        <div class=\"max-w-4xl reveal\">\n            <h2 class=\"font-heading text-4xl md:text-6xl font-bold tracking-ultra-tight uppercase leading-none mb-10\">Project <br> Overview</h2>\n            <p class=\"text-xl md:text-3xl text-gray-500 dark:text-gray-400 font-light leading-relaxed\">\n                Animama is an experimental animation interface designed to liberate digital artists from technical friction. We replaced rigid parameters with a <span class=\"text-black dark:text-white font-medium italic\">Canvas-First</span> architecture, allowing creators to sculpt motion temporalities through natural gestures. It effectively bridges the gap between raw intuition and generative precision.\n            </p>\n        </div>\n    </div>\n</section>\n"
    },
    {
