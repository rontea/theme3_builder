      "renderedContent": "<div class=\"max-w-[1440px] mx-auto px-8 md:px-20 mb-32\">\n    <div class=\"reveal\">\n        <div class=\"relative aspect-[21/9] rounded-[2rem] md:rounded-[3rem] overflow-hidden bg-gray-100 dark:bg-zinc-900 shadow-2xl group\">\n            <img src=\"https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&amp;fit=crop&amp;q=80&amp;w=2000\" alt=\"About RonTea Workspace\" class=\"w-full h-full object-cover transition-transform duration-[2s] group-hover:scale-105\">\n            <div class=\"absolute inset-0 bg-black/5 pointer-events-none\"></div>\n        </div>\n    </div>\n</div>"
