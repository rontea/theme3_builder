    {
      "id": "instance-1772761072283-w276rblyp",
      "order": 3,
      "type": "partial",
      "partial": "about/about_story.html",
      "componentPath": "about/about_story.html",
      "name": "about_story",
      "props": {},
      "renderedContent": "<div class=\"max-w-[1440px] mx-auto px-8 md:px-20 mb-32\">\n    <div class=\"grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24 reveal\">\n        <div class=\"md:col-span-8\">\n            <h2 class=\"font-heading text-4xl md:text-6xl font-bold tracking-ultra-tight uppercase leading-none mb-10\">THE STORY</h2>\n            <div class=\"space-y-8\">\n                <p class=\"text-gray-500 dark:text-gray-400 text-xl md:text-2xl font-light leading-relaxed\">\n                    I am a designer and creative developer based in London. My work focuses on the intersection of human-centric design and technical innovation, aiming to build products that resonate on a deeper level.\n                </p>\n                <p class=\"text-gray-500 dark:text-gray-400 text-lg md:text-xl font-light leading-relaxed\">\n                    With over a decade of experience, I've had the privilege of working with global brands and ambitious startups to define their visual languages and digital architectures. I believe that simplicity is the ultimate sophistication.\n                </p>\n            </div>\n        </div>\n        <div class=\"md:col-span-4 space-y-12 border-l border-black/5 dark:border-white/5 pl-8 md:pl-12\">\n            <div>\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest-xl mb-4\">Core Expertise</p>\n                <ul class=\"font-heading font-bold text-lg uppercase space-y-2\">\n                    <li>Art Direction</li>\n                    <li>Creative Engineering</li>\n                    <li>Generative UI</li>\n                    <li>Digital Strategy</li>\n                </ul>\n            </div>\n            <div>\n                <p class=\"text-[10px] font-bold text-gray-400 uppercase tracking-widest-xl mb-4\">Location</p>\n                <p class=\"font-heading font-bold text-lg uppercase\">London, UK / Remote</p>\n            </div>\n        </div>\n    </div>\n</div>"
    },
    {
      "id": "instance-1772761072288-1f6nk7wwp",
      "order": 4,
      "type": "partial",
      "partial": "about/about_values.html",
      "componentPath": "about/about_values.html",
      "name": "about_values",
      "props": {},
      "renderedContent": "<div class=\"max-w-[1440px] mx-auto px-8 md:px-20 mb-20\">\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-12 border-t border-black/5 dark:border-white/5 pt-20 reveal\">\n        <div class=\"space-y-4\">\n            <h3 class=\"font-heading font-bold text-xl uppercase\">Precision</h3>\n            <p class=\"text-gray-500 dark:text-gray-400 font-light leading-relaxed\">Every pixel serves a purpose. I obsess over the details to ensure a seamless experience.</p>\n        </div>\n        <div class=\"space-y-4\">\n            <h3 class=\"font-heading font-bold text-xl uppercase\">Innovation</h3>\n            <p class=\"text-gray-500 dark:text-gray-400 font-light leading-relaxed\">Leveraging the latest in AI and edge computing to push the boundaries of what's possible on the web.</p>\n        </div>\n        <div class=\"space-y-4\">\n            <h3 class=\"font-heading font-bold text-xl uppercase\">Humanity</h3>\n            <p class=\"text-gray-500 dark:text-gray-400 font-light leading-relaxed\">Technology should empower, not overwhelm. I design for people, not just for screens.</p>\n        </div>\n    </div>\n</div>"
    },
